PORT=5000

# Veritabani: root kullanmayin. Projeye ozel, yetkisi yalnizca bu veritabaniyla
# sinirli bir MySQL kullanicisi olusturun ve guclu bir sifre atayin.
#   CREATE USER 'kpd_app'@'localhost' IDENTIFIED BY '<guclu-sifre>';
#   GRANT ALL PRIVILEGES ON `kartalparkdedemancafe`.* TO 'kpd_app'@'localhost';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kpd_app
DB_PASSWORD=
DB_NAME=kartalparkdedemancafe

# En az 32 karakterlik rastgele bir deger olmalidir.
JWT_SECRET=

HOTEL_TIME_ZONE=Europe/Istanbul

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
